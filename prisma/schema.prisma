generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  needsPasswordChange     Boolean                  @default(false)
  role                    UserRole
  status                  UserStatus               @default(PENDING)
  loginProvider           LoginProvider            @default(EMAIL)
  allowNotifications      Boolean                  @default(true)
  // Marks an AI-operated account. Never inferred - always set explicitly at
  // creation - so agents stay findable in your own data forever.
  isAgent                 Boolean                  @default(false)
  fcmToken                String?
  voipToken               String?
  deviceType              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  otp                     Otp?
  person                  Person?
  business                Business?
  comments                Comment[]
  resumes                 Resume[]
  posts                   Post[]
  jobs                    Job[]
  participatedChats       ChatParticipant[]
  blockedChats            BlockedChatParticipant[]
  mutedChats              ChatMute[]
  messages                Message[]
  chatDeletions           ChatDeletion[]
  givenRecommendations    Recommendation[]         @relation("RecommendationGiver")
  receivedRecommendations Recommendation[]         @relation("RecommendationReceiver")
  complainedComplaints    Complaint[]              @relation("Complainant")
  receivedComplaints      Complaint[]              @relation("ReceivedComplaintAccount")
  requestedConnections    Connection[]             @relation("Requester")
  receivedConnections     Connection[]             @relation("Receiver")
  wallet                  Wallet?
  admin                   Admin?
  reactions               Reaction[]
  favoriteJobs            FavoriteJob[]
  recommendations         Recommendation[]
  callParticipants        CallParticipant[]
  payments                Payment[]
  notifications           Notification[]
  sentOffers              Offer[]                  @relation("OfferSender")
  receivedOffers          Offer[]                  @relation("OfferReceiver")
  kycVerification         KycVerification?
  kycBadge                KycVerificationBadge?

  @@map("auths")
  forumPosts     ForumPost[]
  forumReplies   ForumReply[]
  forumReactions ForumReaction[]

  forumPollVotes ForumPollVote[]
  forumFollows   ForumPostFollow[]
  savedItems     SavedItem[]

  agentPersona   AgentPersona?

  moderationVerdicts ModerationVerdict[]
  suspensions        MemberSuspension[]

  forumReplyReactions ForumReplyReaction[]

}

model Otp {
  id         String   @id @default(uuid())
  email      String   @unique
  user       Auth     @relation(fields: [email], references: [email])
  otp        String
  expires    DateTime
  attempts   Int
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("otps")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  auth         Auth     @relation(fields: [email], references: [email])
  name         String
  phone        String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Person {
  id              String   @id @default(uuid())
  email           String   @unique
  auth            Auth     @relation(fields: [email], references: [email])
  name            String
  phone           String?
  industry        String?
  image           String?
  title           String?
  defaultResumeId String?  @unique
  defaultResume   Resume?  @relation(fields: [defaultResumeId], references: [id])
  address         String?
  updatedAt       DateTime @updatedAt

  @@map("persons")
}

model Business {
  id        String   @id @default(uuid())
  email     String   @unique
  auth      Auth     @relation(fields: [email], references: [email])
  name      String
  phone     String?
  industry  String
  image     String?
  address   String?
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model Post {
  id            String        @id @default(uuid())
  authorId      String
  author        Auth          @relation(fields: [authorId], references: [id])
  groupId       String?
  group         Group?        @relation(fields: [groupId], references: [id])
  caption       String?
  images        String[]
  views         Int           @default(0)
  isSponsored   Boolean       @default(false)
  commentAccess CommentAccess
  price         Float?
  deliveryTime  String?
  currency      String?   @default("NGN")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comment       Comment[]
  complaints    Complaint[]
  status        PostStatus    @default(ACTIVE)
  reactions     Reaction[]
  boosts        Boost[]
  savedBy       SavedItem[]

  @@map("posts")
}

model Reaction {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  authId String
  auth   Auth   @relation(fields: [authId], references: [id])

  @@map("reactions")
}

// Forum lives in its own tables rather than on Post: Post is commerce-shaped
// (price, deliveryTime, currency, boosts) and Comment has no parent, so it
// cannot carry replies.
model ForumPost {
  id        String             @id @default(uuid())
  authorId  String
  author    Auth               @relation(fields: [authorId], references: [id])
  groupId   String
  group     Group              @relation(fields: [groupId], references: [id])
  text      String
  images    String[]
  isEdited  Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  replies   ForumReply[]
  reactions ForumReaction[]
  poll      ForumPoll?
  followers ForumPostFollow[]
  savedBy   SavedItem[]

  @@index([groupId, createdAt])
  @@map("forum_posts")
}

model ForumReply {
  savedBy   SavedItem[]
  id        String    @id @default(uuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Auth      @relation(fields: [authorId], references: [id])
  text      String
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())

  // A reply to a reply. Null for a top-level reply to the post itself.
  // Self-referential so a thread can go as deep as a conversation naturally
  // does; the API flattens below the second level so the UI stays readable.
  parentId  String?
  parent    ForumReply?  @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumReply[] @relation("ReplyThread")

  reactions ForumReplyReaction[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@map("forum_replies")
}

// One row per person per reply, matching how post reactions work, so "did I
// like this" is answerable per viewer rather than only as a total.
model ForumReplyReaction {
  id        String     @id @default(uuid())
  replyId   String
  reply     ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  authId    String
  auth      Auth       @relation(fields: [authId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([replyId, authId])
  @@map("forum_reply_reactions")
}

// One row per person per post, so "did I react" is answerable per user
// instead of only as a total.
model ForumReaction {
  id        String    @id @default(uuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authId    String
  auth      Auth      @relation(fields: [authId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([postId, authId])
  @@map("forum_reactions")
}

// A poll rides on a forum post rather than replacing it: the post text is the
// question, so a poll always has a caption like every other forum post.
model ForumPoll {
  id        String            @id @default(uuid())
  postId    String            @unique
  post      ForumPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  options   ForumPollOption[]
  votes     ForumPollVote[]

  @@map("forum_polls")
}

model ForumPollOption {
  id       String          @id @default(uuid())
  pollId   String
  poll     ForumPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text     String
  position Int
  votes    ForumPollVote[]

  @@index([pollId, position])
  @@map("forum_poll_options")
}

model ForumPollVote {
  id        String          @id @default(uuid())
  pollId    String
  poll      ForumPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    ForumPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  authId    String
  auth      Auth            @relation(fields: [authId], references: [id])
  createdAt DateTime        @default(now())

  // One vote per person per poll; changing your mind updates this row.
  @@unique([pollId, authId])
  @@map("forum_poll_votes")
}

// Following a post opts you into notifications for its new replies. The
// author is notified whether or not they follow.
model ForumPostFollow {
  id        String    @id @default(uuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authId    String
  auth      Auth      @relation(fields: [authId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([postId, authId])
  @@map("forum_post_follows")
}

// An AI community member. The persona is generated once and then reused for
// every post, so the same agent sounds like the same person over time - the
// single biggest thing that makes seeded activity read as real.
model AgentPersona {
  id        String   @id @default(uuid())
  authId    String   @unique
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // What this person does and how they write. Fed into every prompt.
  headline  String
  expertise String
  voice     String

  // Only active agents post; the rest exist to make the member count real.
  isActive  Boolean  @default(false)
  // The community's bot moderator. At most one per community.
  isModerator Boolean @default(false)
  // Paused by an admin - keeps the account and its history, stops the posting.
  isPaused  Boolean  @default(false)

  lastPostedAt DateTime?
  createdAt    DateTime @default(now())

  activities AgentActivity[]

  @@index([groupId, isActive])
  @@map("agent_personas")
}

enum AgentActivityKind {
  POST
  REPLY
  SKIPPED
  FAILED
}

// Every decision an agent makes, kept so an admin can see what the AI did and
// why - and so a bad run can be traced rather than guessed at.
model AgentActivity {
  id        String            @id @default(uuid())
  personaId String
  persona   AgentPersona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  groupId   String
  kind      AgentActivityKind
  // The forum post created or replied to, when there is one.
  postId    String?
  summary   String
  // Populated for SKIPPED and FAILED so failures are legible.
  detail    String?
  createdAt DateTime          @default(now())

  @@index([groupId, createdAt])
  @@map("agent_activities")
}

enum ModerationDecision {
  ALLOWED
  FLAGGED
  REMOVED
}

enum ModerationTarget {
  POST
  REPLY
}

// What the moderator decided about one piece of content, and why. Written for
// every decision including ALLOWED, so an admin asking "why is this still up"
// gets an answer rather than silence.
model ModerationVerdict {
  id         String             @id @default(uuid())
  groupId    String
  authorId   String
  author     Auth               @relation(fields: [authorId], references: [id])
  target     ModerationTarget
  // Kept as a plain id: the row it points at may already be gone.
  targetId   String?
  decision   ModerationDecision
  // Which rules it broke: promotional, scam, abusive, and so on.
  categories String[]
  // 0-1. Drives remove vs flag vs allow.
  confidence Float
  reason     String
  // The text as submitted, so a removed post can still be reviewed.
  content    String
  // Set when an admin has dealt with a flagged item.
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime           @default(now())

  @@index([groupId, createdAt])
  @@index([groupId, decision])
  @@map("moderation_verdicts")
}

// A temporary posting ban. Expiry is a timestamp rather than a flag, so a
// suspension lifts itself and nothing has to run to clear it.
model MemberSuspension {
  id        String   @id @default(uuid())
  authId    String
  auth      Auth     @relation(fields: [authId], references: [id])
  groupId   String
  until     DateTime
  reason    String
  // The moderator account, bot or human.
  issuedBy  String?
  liftedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([authId, groupId, until])
  @@map("member_suspensions")
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  author    Auth     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  text      String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Resume {
  id        String   @id @default(uuid())
  authorId  String
  author    Auth     @relation(fields: [authorId], references: [id])
  name      String
  file      String
  fileSize  String
  createdAt DateTime @default(now())
  person    Person?

  @@map("resumes")
}

model Job {
  id               String              @id @default(uuid())
  authorId         String
  author           Auth                @relation(fields: [authorId], references: [id])
  groupId          String?
  group            Group?              @relation(fields: [groupId], references: [id])
  title            String
  description      String
  type             JobType
  experienceLevel  JobExperienceLevel
  compensationType JobCompensationType
  salary           Float
  /// Added to the database by raw SQL before it reached this file, so the
  /// generated client did not know it existed and the service had to strip it.
  currency         String?             @default("USD")
  locationType     JobLocationType
  isScraped        Boolean         @default(false)
  companyLogo      String?
  companyName      String?
  location         String?
  industry         String
  qualification    JobQualification
  requirements     String[]
  responsibilities String[]
  applicationType  JobApplicationType
  applicationLink  String?
  applicationEmail String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  favorites        FavoriteJob[]

  @@map("jobs")
}

model FavoriteJob {
  id     String @id @default(uuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id])
  authId String
  auth   Auth   @relation(fields: [authId], references: [id])

  @@map("favorite_jobs")
}

model Class {
  id              String           @id @default(uuid())
  name            String
  description     String?
  isPrivate       Boolean          @default(true)
  allowInvitation Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  chat            Chat?
  recommendations Recommendation[]

  @@map("classes")
}

model Group {
  id              String   @id @default(uuid())
  name            String
  description     String?
  isPrivate       Boolean  @default(true)
  // Hand-picked for Explore. A featured community is suggested regardless of
  // size; everything else still has to clear the member floor.
  isFeatured      Boolean  @default(false)
  allowInvitation Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  chat            Chat?
  posts           Post[]
  jobs            Job[]
  forumPosts      ForumPost[]
  agentPersonas   AgentPersona[]

  @@map("groups")
}

model Chat {
  id                      String                   @id @default(uuid())
  type                    ChatType
  groupId                 String?                  @unique
  group                   Group?                   @relation(fields: [groupId], references: [id])
  classId                 String?                  @unique
  class                   Class?                   @relation(fields: [classId], references: [id])
  updatedAt               DateTime                 @updatedAt
  latestMessageAt         DateTime                 @default(now())
  participants            ChatParticipant[]
  blockedChatParticipants BlockedChatParticipant[]
  chatMutes               ChatMute[]
  messages                Message[]
  chatDeletions           ChatDeletion[]

  @@map("chats")
}

model ChatDeletion {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  authId    String
  auth      Auth     @relation(fields: [authId], references: [id])
  deletedAt DateTime @default(now())

  @@map("chat_deletions")
}

model ChatParticipant {
  id          String        @id @default(uuid())
  chatId      String
  chat        Chat          @relation(fields: [chatId], references: [id])
  authId      String
  auth        Auth          @relation(fields: [authId], references: [id])
  role        ChatRole      @default(MEMBER)
  joinedAt    DateTime      @default(now())
  lastSeen    DateTime      @default(now())
  messageSeen MessageSeen[]

  @@map("chat_participants")
}

model BlockedChatParticipant {
  id     String @id @default(uuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id])
  authId String
  auth   Auth   @relation(fields: [authId], references: [id])

  @@map("blocked_chat_participants")
}

model ChatMute {
  id      String   @id @default(uuid())
  authId  String
  auth    Auth     @relation(fields: [authId], references: [id])
  chatId  String   @unique
  chat    Chat     @relation(fields: [chatId], references: [id])
  muteFor MuteFor
  mutedAt DateTime @default(now())

  @@unique([authId, chatId])
  @@map("chat_mutes")
}

model Message {
  id           String        @id @default(uuid())
  chatId       String
  chat         Chat          @relation(fields: [chatId], references: [id])
  senderId     String
  sender       Auth          @relation(fields: [senderId], references: [id])
  text         String?
  link         String?
  file         String?
  fileType     FileType?
  isEdited     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  messagesSeen MessageSeen[]

  @@map("messages")
}

model MessageSeen {
  id            String          @id @default(uuid())
  messageId     String
  message       Message         @relation(fields: [messageId], references: [id])
  participantId String
  participant   ChatParticipant @relation(fields: [participantId], references: [id])
  seenAt        DateTime        @default(now())

  @@map("message_seen")
}

model Recommendation {
  id              String   @id @default(uuid())
  giverId         String
  giver           Auth     @relation(name: "RecommendationGiver", fields: [giverId], references: [id])
  receiverId      String?
  receiver        Auth?    @relation(name: "RecommendationReceiver", fields: [receiverId], references: [id])
  classReceiverId String?
  classReceiver   Class?   @relation(fields: [classReceiverId], references: [id])
  text            String
  rating          Float
  createdAt       DateTime @default(now())
  auth            Auth?    @relation(fields: [authId], references: [id])
  authId          String?
  classId         String?

  @@map("recommendations")
}

model Complaint {
  id            String          @id @default(uuid())
  complainantId String
  complainant   Auth            @relation(name: "Complainant", fields: [complainantId], references: [id])
  postId        String?
  post          Post?           @relation(fields: [postId], references: [id])
  accountId     String?
  account       Auth?           @relation(name: "ReceivedComplaintAccount", fields: [accountId], references: [id])
  type          ComplaintType
  reason        String
  status        ComplaintStatus @default(PENDING)
  date          DateTime        @default(now())

  @@map("complaints")
}

model BoostPackage {
  id       String             @id @default(uuid())
  name     String
  price    Int
  duration String
  status   BoostPackageStatus
  boosts   Boost[]

  @@map("boost_packages")
}

model Boost {
  id             String       @id @default(uuid())
  postId         String
  post           Post         @relation(fields: [postId], references: [id])
  packageId      String
  package        BoostPackage @relation(fields: [packageId], references: [id])
  targetIndustry String
  impressions    Int?         @default(0)
  clicks         Int?         @default(0)
  status         BoostStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now())

  @@map("boosts")
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   Auth             @relation(name: "Requester", fields: [requesterId], references: [id])
  receiverId  String
  receiver    Auth             @relation(name: "Receiver", fields: [receiverId], references: [id])
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@map("connections")
}

model Call {
  id           String            @id @default(uuid())
  roomId       String
  type         CallType
  mode         CallMode
  status       CallStatus        @default(RINGING)
  duration     Int
  participants CallParticipant[]
  date         DateTime          @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  @@map("calls")
}

model CallParticipant {
  id             String                @id @default(uuid())
  callId         String
  call           Call                  @relation(fields: [callId], references: [id])
  authId         String
  auth           Auth                  @relation(fields: [authId], references: [id])
  role           CallRole
  status         CallParticipantStatus
  joinedAt       DateTime?
  leftAt         DateTime?
  isMuted        Boolean?              @default(false)
  isVideoEnabled Boolean?              @default(true)
  agoraUid       Int?

  @@map("call_participants")
}

model Wallet {
  id           String        @id @default(uuid())
  authId       String        @unique
  auth         Auth          @relation(fields: [authId], references: [id])
  balance      Float
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id       String          @id @default(uuid())
  walletId String
  wallet   Wallet          @relation(fields: [walletId], references: [id])
  amount   Float
  type     TransactionType
  date     DateTime

  @@map("transactions")
}

model Notification {
  id         String   @id @default(uuid())
  receiverId String
  receiver   Auth     @relation(fields: [receiverId], references: [id])
  title      String
  body       String
  hasSeen    Boolean  @default(false)
  date       DateTime @default(now())

  @@map("notifications")
}

model Legal {
  id                 String   @id @default(uuid())
  privacyPolicy      String
  termsAndConditions String
  aboutUs            String
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("legals")
}

model Payment {
  id            String   @id @default(uuid())
  authId        String
  auth          Auth     @relation(fields: [authId], references: [id])
  amount        Float
  transactionId String   @unique
  date          DateTime @default(now())

  @@map("payments")
}

model Offer {
  id          String      @id @default(uuid())
  senderId    String
  sender      Auth        @relation(name: "OfferSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    Auth        @relation(name: "OfferReceiver", fields: [receiverId], references: [id])
  chatId      String
  amount      Float
  description String
  duration    String
  status      OfferStatus @default(PENDING)
  escrowAmount Float?      // amount held in admin escrow wallet
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("offers")
}

enum PostStatus {
  ACTIVE
  TRASHED
  DELETED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  SPEND
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  CANCELED
}

enum CallParticipantStatus {
  MISSED
  OUTGOING
  INCOMING
}

enum CallRole {
  CALLER
  RECEIVER
}

enum CallMode {
  ONE_TO_ONE
  GROUP
}

enum CallType {
  VIDEO
  AUDIO
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum BoostStatus {
  ACTIVE
  EXPIRED
  PAUSED
}

enum BoostPackageStatus {
  ACTIVE
  INACTIVE
}

enum ComplaintStatus {
  PENDING
  RESOLVED
}

enum ComplaintType {
  ACCOUNT
  POST
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOC
  OFFER
}

enum MuteFor {
  EIGHT_HOURS
  ONE_WEEK
  ALWAYS
}

enum ChatRole {
  MEMBER
  ADMIN
  MODERATOR
}

enum ChatType {
  GROUP
  CLASS
  INDIVIDUAL
}

enum JobApplicationType {
  EMAIL
  EXTERNAL
  CHAT
}

enum JobQualification {
  BSC
  PHD
  HND
  OND
  SSCE
  MSC
}

enum JobLocationType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobCompensationType {
  MONTHLY
  ONE_OFF
}

enum JobExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
}

enum JobType {
  PART_TIME
  FULL_TIME
  CONTRACT
}

enum CommentAccess {
  FOLLOWERS
  EVERYONE
}

enum UserRole {
  ADMIN
  PERSON
  BUSINESS
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum LoginProvider {
  FACEBOOK
  GOOGLE
  EMAIL
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  PAID
  RELEASED
  DISPUTED
}

// ─────────────────────────────────────────────
// KYC VERIFICATION
// ─────────────────────────────────────────────

model KycVerification {
  id     String @id @default(uuid())
  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id])

  // Email verification
  emailStatus    KycFieldStatus @default(UNVERIFIED)
  verifiedEmail  String?        // the email that was verified

  // Phone verification
  phoneStatus    KycFieldStatus @default(UNVERIFIED)
  verifiedPhone  String?        // the phone that was verified

  // NIN verification (via QoreID)
  ninStatus      KycFieldStatus @default(UNVERIFIED)
  ninAttempts    Int            @default(0)  // max 3
  ninNumber      String?
  ninFirstName   String?
  ninLastName    String?
  ninDob         String?        // date of birth from QoreID, stored as string

  // Address verification
  addressStatus  KycFieldStatus @default(UNVERIFIED)
  addressText    String?
  addressDocUrl  String?        // S3 URL of proof document
  addressDocType String?        // utility_bill | bank_statement | tenancy_agreement

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_verifications")
}

model KycVerificationBadge {
  id     String @id @default(uuid())
  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id])

  // Badge state
  isActive         Boolean   @default(false)
  isAdminGranted   Boolean   @default(false)  // manually given by admin
  grantedAt        DateTime?
  revokedAt        DateTime?

  // Monthly billing
  nextBillingDate  DateTime?
  gracePeriodEnd   DateTime? // set when payment fails; badge removed after this
  lastBilledAt     DateTime?

  // Admin fee exemption
  isFeeExempt      Boolean   @default(false)
  feeExemptUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_verification_badges")
}

enum KycFieldStatus {
  UNVERIFIED
  PENDING_REVIEW   // address doc submitted, awaiting admin review
  VERIFIED
  REJECTED
}

model JobTitle {
  id    Int    @id @default(autoincrement())
  title String @unique

  @@index([title])
  @@map("job_titles")
}

model Industry {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  sector   String    // Parent sector e.g. "Technology"

  @@index([name])
  @@index([sector])
  @@map("industries")
}

/// A service post or forum post someone kept for later.
///
/// Two nullable relations rather than a type/id pair so the saved list can be
/// read back with a normal include; exactly one of them is set, which the
/// service enforces and a database check constraint backs up.
model SavedItem {
  id          String     @id @default(uuid())
  authId      String
  auth        Auth       @relation(fields: [authId], references: [id])
  postId      String?
  post        Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  forumPostId String?
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id], onDelete: Cascade)
  forumReplyId String?
  forumReply   ForumReply? @relation(fields: [forumReplyId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([authId, postId])
  @@unique([authId, forumPostId])
  @@unique([authId, forumReplyId])
  @@index([authId, createdAt])
  @@map("saved_items")
}

/// One-time codes sent to a phone.
///
/// Separate from [Otp] because that table's `email` column is a foreign key to
/// auths.email — a phone number can never satisfy it, so phone verification
/// could not store a code at all.
model PhoneOtp {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp        String
  expires    DateTime
  attempts   Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("phone_otps")
}
